# Workflow OS — 환경 변수 설정 예시
# 이 파일을 .env로 복사하고 값을 채워라: cp .env.example .env
# .env는 gitignore 대상이며 절대 커밋하지 마라.
# 현재 플래그 상태 확인: npm run env:status

# ── 서버 설정 ───────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# ── Feature Flag 런타임 오버라이드 ──────────────────────────────────────
# flags.yaml의 기본값(false)을 코드 변경 없이 덮어쓴다.
# 변환 규칙: flag key의 dot/hyphen → underscore, 대문자, WOS_FLAG_ 접두어
# 적용: npm start 시 서버 stderr에 "[FeatureFlagProvider] ENV override: ..." 로그 출력됨.
# 미선언 플래그는 env로도 생성되지 않는다 (phantom flag 방지).

# ── released 단계 플래그 — 주석 제거 후 즉시 전체 적용 가능 ──────────────
# WOS_FLAG_ENABLE_TASK_MANAGEMENT=true
# WOS_FLAG_BILLING_ENABLED=true
# WOS_FLAG_BILLING_INVOICE_ENABLED=true
# WOS_FLAG_BILLING_PAYMENT_ENABLED=true
# WOS_FLAG_VIDEO_ENABLED=true
# WOS_FLAG_VIDEO_UPLOAD_ENABLED=true

# ── internal 단계 플래그 — 권한/검토 후 활성화 ───────────────────────────
# WOS_FLAG_ENABLE_EXPERIMENTAL_FEATURES=true # internal
# WOS_FLAG_ENABLE_DEBUG_MODE=true # internal
# WOS_FLAG_ENABLE_BULK_ASSIGN=true # internal
# WOS_FLAG_BILLING_EXCEPTION_ENABLED=true # internal
# WOS_FLAG_VIDEO_TRANSCODE_ENABLED=true # internal
# WOS_FLAG_VIDEO_ADMIN_ENABLED=true # internal

# ── System OS UI API ─────────────────────────────────────────────────────────
# 활성화 순서: system_api.enabled → SSE/카탈로그/감사 → flag_toggle_ui/rollback_ui
# 긴급 차단: WOS_FLAG_SYSTEM_API_ENABLED=false → 서버 재시작만으로 즉시 비활성화
# WOS_FLAG_SYSTEM_API_ENABLED=true               # internal — System OS UI API 전체 활성화
# WOS_FLAG_SYSTEM_API_SSE_STREAM_ENABLED=true    # internal — SSE 실시간 스트림
# WOS_FLAG_SYSTEM_API_FLAG_TOGGLE_UI_ENABLED=true # internal — 플래그 토글 (system.admin 전용)
# WOS_FLAG_SYSTEM_API_ROLLBACK_UI_ENABLED=true   # internal — 롤백 콘솔 (system.admin 전용)

# ── 데이터베이스 (선택) ──────────────────────────────────────────────────────
# DB_TYPE=sqlite           # 기본값 — sqlite | postgres | inmemory
#                          # inmemory: 재시작 시 전체 초기화 (테스트 전용)
#
# SQLite 파일 경로 (기본값: :memory: → 재시작마다 초기화됨)
# 영속성이 필요하면 파일 경로를 지정하세요:
# TASK_SQLITE_DB_PATH=./data/tasks.db
#
# PostgreSQL (DB_TYPE=postgres 시):
# POSTGRES_URL=postgresql://user:pass@localhost:5432/my_module
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=my_module
# POSTGRES_SCHEMA=public          # (선택) 기본값: public
# POSTGRES_TASK_TABLE=tasks       # (선택) 기본값: tasks
#
# 스키마 초기화: psql $POSTGRES_URL < domains/productivity/task-tracking/src/infrastructure/migrations/001_initial_pg.sql
# 전환 전제 조건: docs/db/migration-strategy.md Phase 2 참조

# ── AI Harness — live provider 연결 (선택) ───────────────────────────────────
# 키 없으면 NullProvider fallback — 모든 기능 정상 동작 (추천만 null 반환).
# 활성화 후 검증: POST http://localhost:3000/api/harness/prompt-recommendation
#   Body: { "mode": "Build", "basePrompt": "next sprint planning" }
#   기대: body.provider.provider_id = "openai-responses"
# HARNESS_PROVIDER=openai                         # "openai" 설정 시 OpenAI Responses API 사용
# OPENAI_API_KEY=sk-...                           # OpenAI Responses API 키
# OPENAI_BASE_URL=https://api.openai.com/v1       # (선택) 커스텀 엔드포인트
# OPENAI_MODEL_FRONTIER=gpt-4o                    # (선택) frontier 모델 (기본값: gpt-4o)
# OPENAI_MODEL_STANDARD=gpt-4o-mini               # (선택) standard 모델
# OPENAI_MODEL_MINI=gpt-4o-mini                   # (선택) mini 모델

# ── AI Harness routing flags ─────────────────────────────────────────────────
# WOS_FLAG_HARNESS_ROUTING_FRONTIER_RESEARCH=true
# WOS_FLAG_HARNESS_ROUTING_MINI_BUILD=true
# WOS_FLAG_HARNESS_PROMPT_CACHING_ENABLED=true
# WOS_FLAG_HARNESS_BATCH_EVAL_ENABLED=true
