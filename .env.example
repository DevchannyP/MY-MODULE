# Workflow OS — 환경 변수 설정 예시
# 이 파일을 .env로 복사하고 값을 채워라: cp .env.example .env
# .env는 gitignore 대상이며 절대 커밋하지 마라.

# ── 서버 설정 ───────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# ── Feature Flag 런타임 오버라이드 ──────────────────────────────────────
# flags.yaml의 기본값(false)을 코드 변경 없이 덮어쓴다.
# 변환 규칙: flag key의 dot/hyphen → underscore, 대문자, WOS_FLAG_ 접두어
# 적용: npm start 시 서버 stderr에 "[FeatureFlagProvider] ENV override: ..." 로그 출력됨.
# 미선언 플래그는 env로도 생성되지 않는다 (phantom flag 방지).

# task-management 플러그인 활성화
# WOS_FLAG_ENABLE_TASK_MANAGEMENT=true
# WOS_FLAG_ENABLE_BULK_ASSIGN=true

# billing 플러그인 활성화
# WOS_FLAG_BILLING_ENABLED=true
# WOS_FLAG_BILLING_INVOICE_ENABLED=true
# WOS_FLAG_BILLING_PAYMENT_ENABLED=true
# WOS_FLAG_BILLING_EXCEPTION_ENABLED=true

# video 플러그인 활성화
# WOS_FLAG_VIDEO_ENABLED=true
# WOS_FLAG_VIDEO_UPLOAD_ENABLED=true
# WOS_FLAG_VIDEO_TRANSCODE_ENABLED=true
# WOS_FLAG_VIDEO_ADMIN_ENABLED=true

# 전역 플래그
# WOS_FLAG_ENABLE_EXPERIMENTAL_FEATURES=true
# WOS_FLAG_ENABLE_DEBUG_MODE=true
