{
  "name": "my-module",
  "version": "0.1.0",
  "description": "Workflow OS - requirements 기반 초격리 모듈 저장소",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test 'domains/**/tests/**/*.test.js'",
    "test:contract": "python3 scripts/validate_contract_drift.py",
    "test:integration": "node --test 'domains/**/tests/application/**/*.test.js'",
    "test:e2e-smoke": "node --test 'domains/**/tests/smoke/**/*.test.js' 'src/tests/smoke/**/*.test.js'",
    "test:property": "node --test 'domains/**/tests/property/**/*.test.js'",
    "lint": "npm run lint:syntax && npm run lint:eslint",
    "lint:syntax": "node scripts/check-syntax.js",
    "lint:eslint": "node_modules/.bin/eslint domains src scripts",
    "type-check": "python3 scripts/check_type_boundaries.py",
    "static-analysis": "npm run lint:eslint",
    "validate:composition": "python3 scripts/validate_master_shell.py",
    "scan:secrets": "git log --all --full-history -- '*.env' | head -5 && grep -rn 'password\\|secret\\|token\\|api_key' domains/ src/ --include='*.js' | grep -v test | grep -v node_modules || echo 'secret scan: 의심 패턴 없음'",
    "scan:dependencies": "python3 scripts/validate_dependency_baseline.py",
    "check:advisory-policy": "python3 scripts/validate_advisory_policy.py",
    "check:branch-protection-policy": "python3 scripts/validate_branch_protection_policy.py",
    "check:deployment-smoke-binding": "python3 scripts/validate_deployment_smoke_binding.py",
    "check:deployment-environment-provisioning": "python3 scripts/validate_deployment_environment_provisioning.py",
    "test:authn-authz": "node --test 'domains/**/tests/interface/**/*.test.js'",
    "test:input-validation": "node --test 'domains/**/tests/**/*.test.js'",
    "generate:sbom": "python3 scripts/generate_sbom.py",
    "generate:release-evidence": "python3 scripts/generate_release_evidence.py",
    "verify:provenance": "python3 scripts/verify_provenance.py",
    "audit:verify": "node scripts/audit-chain.js verify",
    "test:rollback": "python3 scripts/validate_operations.py rollback",
    "check:observability": "python3 scripts/validate_operations.py observability",
    "smoke:deployment": "node scripts/run_deployment_smoke.js",
    "generate:deployment-environment-audit-template": "python3 scripts/generate_deployment_environment_audit_template.py",
    "validate:requirements": "python3 scripts/validate_requirements.py",
    "validate:fitness": "node scripts/architecture-fitness.js",
    "boundary:check": "node scripts/architecture-fitness.js",
    "validate:contracts": "node scripts/validate-contracts.js",
    "generate:graph": "node scripts/generate-dep-graph.js",
    "generate:from-contracts": "node scripts/generate-from-contracts.js",
    "orchestrate": "node scripts/orchestrate.js",
    "orchestrate:json": "node scripts/orchestrate.js --json",
    "adr:new": "node scripts/generate-adr.js",
    "adr:index": "node scripts/generate-adr.js --index-only",
    "knowledge-graph:update": "node scripts/update-knowledge-graph.js",
    "health": "node scripts/health-dashboard.js",
    "health:json": "node scripts/health-dashboard.js --json",
    "error-budget": "node scripts/error-budget-check.js",
    "release:evidence": "node scripts/generate-release-evidence.js",
    "catalog": "node scripts/generate-catalog-site.js",
    "planner": "python3 scripts/generate-master-planner.py",
    "project:status": "node scripts/project_status.js",
    "stage:a": "node scripts/run_stage.js A --dry-run",
    "stage:b": "node scripts/run_stage.js B --dry-run",
    "stage:c": "node scripts/run_stage.js C --dry-run",
    "stage:d": "node scripts/run_stage.js D --dry-run",
    "stage:e": "node scripts/run_stage.js E --dry-run",
    "wp:next": "python3 scripts/wp_scheduler.py",
    "wp:status": "python3 scripts/wp_scheduler.py --all",
    "wp:validate": "python3 scripts/wp_scheduler.py --validate",
    "wp:gaps": "python3 scripts/requirements_gap.py",
    "wp:gaps:gen": "python3 scripts/requirements_gap.py --gen",
    "wp:health": "python3 scripts/session_metrics.py",
    "wp:health:trend": "python3 scripts/session_metrics.py --trend",
    "wp:reconcile": "python3 scripts/reconcile_state.py",
    "wp:reconcile:apply": "python3 scripts/reconcile_state.py --apply",
    "db:migrate": "node -e \"const {SQLiteTaskRepository}=require('./domains/productivity/task-tracking/src/infrastructure/SQLiteTaskRepository');SQLiteTaskRepository.create('./data/tasks.db');console.log('Migration complete: data/tasks.db');\"",
    "db:migrate:test": "node -e \"const {SQLiteTaskRepository}=require('./domains/productivity/task-tracking/src/infrastructure/SQLiteTaskRepository');SQLiteTaskRepository.create(':memory:');console.log('Schema OK (in-memory)');\"",
    "session:end": "python3 scripts/session_end.py",
    "session:end:apply": "python3 scripts/session_end.py --apply",
    "prepare": "husky",
    "test:turbo": "turbo run test",
    "gate:turbo": "turbo run gate",
    "gate:all": "turbo run gate --parallel"
  },
  "keywords": [
    "workflow-os",
    "domain-driven-design",
    "bounded-context",
    "contracts"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "turbo": "^2.8.20"
  }
}
