{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-os/contracts/harness/wp-dag.schema.json",
  "title": "Workflow OS MPO Work Packet DAG Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "intake_packet",
    "wp_list",
    "edges"
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "pathList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "session_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "intake_packet": {
      "type": "object"
    },
    "wp_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "domain",
          "layer",
          "work_mode",
          "packet_type",
          "depends_on",
          "parallelizable"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "title": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "objective": {
            "type": "string"
          },
          "domain": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "layer": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "work_mode": {
            "type": "string",
            "enum": [
              "Research",
              "Build",
              "Debug",
              "Operate",
              "Policy"
            ]
          },
          "packet_type": {
            "type": "string",
            "enum": [
              "feature",
              "bugfix",
              "refactor",
              "docs",
              "ops",
              "spike"
            ]
          },
          "status": {
            "type": "string"
          },
          "depends_on": {
            "$ref": "#/$defs/pathList"
          },
          "parallelizable": {
            "type": "boolean"
          },
          "estimated_duration_min": {
            "type": "integer",
            "minimum": 0
          },
          "estimated_token_cost": {
            "type": "integer",
            "minimum": 0
          },
          "allowed_paths": {
            "$ref": "#/$defs/pathList"
          },
          "read_only_paths": {
            "$ref": "#/$defs/pathList"
          },
          "forbidden_paths": {
            "$ref": "#/$defs/pathList"
          },
          "context_envelope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "canonical_files": {
                "$ref": "#/$defs/pathList"
              },
              "partial_files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "line_start",
                    "line_end"
                  ],
                  "properties": {
                    "path": {
                      "$ref": "#/$defs/nonEmptyString"
                    },
                    "line_start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "line_end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "estimated_context_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "token_budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "budget": {
                "type": "integer",
                "minimum": 0
              },
              "cap": {
                "type": "integer",
                "minimum": 0
              },
              "warning_threshold": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "provider_tier": {
            "type": "string",
            "enum": [
              "frontier",
              "standard",
              "mini"
            ]
          },
          "fallback_chain": {
            "$ref": "#/$defs/pathList"
          },
          "verification_bundle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command",
                    "pass_criteria"
                  ],
                  "properties": {
                    "command": {
                      "$ref": "#/$defs/nonEmptyString"
                    },
                    "pass_criteria": {
                      "$ref": "#/$defs/nonEmptyString"
                    }
                  }
                }
              },
              "optional": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command"
                  ],
                  "properties": {
                    "command": {
                      "$ref": "#/$defs/nonEmptyString"
                    },
                    "pass_criteria": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "route": {
            "type": "object"
          },
          "execution_result": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "to": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "type": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "plan_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_wps": {
          "type": "integer",
          "minimum": 0
        },
        "total_estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "approval_state": {
          "type": "string"
        }
      }
    }
  }
}
