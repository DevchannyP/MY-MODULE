{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-os/requirements.schema.json",
  "title": "Workflow OS Requirements Input Schema",
  "description": "requirements/requirements.yaml top-level contract for Stage A entry validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "module",
    "stage",
    "contracts",
    "nfr",
    "quality_gates",
    "composition",
    "feature_flags",
    "routing"
  ],
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "contractPath": {
      "type": "string",
      "pattern": "^(domains|platform)/.+/(contract|contracts)/[^/]+$"
    },
    "gateList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "domain",
        "bounded_context",
        "owner",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "domain": {
          "$ref": "#/$defs/kebabId"
        },
        "bounded_context": {
          "$ref": "#/$defs/kebabId"
        },
        "owner": {
          "type": "string",
          "minLength": 2
        },
        "description": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "stage": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http", "events", "ui", "capability"],
      "properties": {
        "http": {
          "allOf": [
            { "$ref": "#/$defs/contractPath" },
            { "pattern": "openapi\\.yaml$" }
          ]
        },
        "events": {
          "allOf": [
            { "$ref": "#/$defs/contractPath" },
            { "pattern": "events\\.schema\\.json$" }
          ]
        },
        "ui": {
          "allOf": [
            { "$ref": "#/$defs/contractPath" },
            { "pattern": "ui-contract\\.yaml$" }
          ]
        },
        "capability": {
          "allOf": [
            { "$ref": "#/$defs/contractPath" },
            { "pattern": "capability\\.yaml$" }
          ]
        }
      }
    },
    "nfr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_p99_ms",
        "availability_percent",
        "rpo_minutes",
        "rto_minutes"
      ],
      "properties": {
        "latency_p99_ms": {
          "type": "integer",
          "minimum": 1
        },
        "availability_percent": {
          "type": "number",
          "minimum": 90,
          "maximum": 100
        },
        "rpo_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "rto_minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "code_health",
        "security",
        "supply_chain"
      ],
      "properties": {
        "correctness": {
          "$ref": "#/$defs/gateList"
        },
        "code_health": {
          "$ref": "#/$defs/gateList"
        },
        "security": {
          "$ref": "#/$defs/gateList"
        },
        "supply_chain": {
          "$ref": "#/$defs/gateList"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depends_on", "provides"],
      "properties": {
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractPath"
          },
          "uniqueItems": true
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractPath"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "feature_flags": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_point", "navigation_group", "plugin_slot"],
      "properties": {
        "entry_point": {
          "type": "string",
          "pattern": "^/"
        },
        "navigation_group": {
          "$ref": "#/$defs/kebabId"
        },
        "plugin_slot": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
